{
  "compilerOptions": {
    "target": "ES2024",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2024", "DOM"],
    "types": ["node", "vitest"],
    "strict": false,
    "noEmit": true,
    "skipLibCheck": true,
    "allowJs": true,
    "checkJs": false
  },
  "include": [
    "mcp/**/*.mjs",
    "lib/**/*.js",
    "tools/**/*.js",
    "scripts/**/*.mjs",
    "tests/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
